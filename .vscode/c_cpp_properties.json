{
    "configurations": [
        {
            "name": "Win32",
            "includePath": [
                "${workspaceFolder}/Hardware/**",
                "${workspaceFolder}/Hardware/Core/inc",
                "${env:ARMGCC_DIR}/arm-none-eabi/include"
            ],
            "defines": [
                "_DEBUG",
                "UNICODE",
                "_UNICODE",
                "STM32F756xx"
            ],
            "compilerPath": "${env:ARMGCC_DIR}/bin/arm-none-eabi-gcc-14.2.1.exe",
            "cStandard": "c17",
            "cppStandard": "c++17",
            "intelliSenseMode": "windows-gcc-arm",
            "compilerArgs": [
                "-mcpu=cortex-m7",
                "-mthumb"
            ]
        },
        {
            "name": "Linux",
            "includePath": [
                "${workspaceFolder}/**",
                "${workspaceFolder}/Core/inc",
                "/usr/lib/arm-none-eabi/include"
            ],
            "defines": [
                "_DEBUG",
                "UNICODE",
                "_UNICODE",
                "STM32F756xx"
            ],
            "compilerPath": "/usr/bin/arm-none-eabi-gcc",
            "cStandard": "c17",
            "cppStandard": "c++17",
            "intelliSenseMode": "linux-gcc-arm",
            "compilerArgs": [
                "-mcpu=cortex-m7",
                "-mthumb"
            ]
        }
    ],
    "version": 4
}