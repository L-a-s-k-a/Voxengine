   6:Core/src/it_handlers.c **** /**
   7:Core/src/it_handlers.c ****  * @brief SysTick = 1 кГц. Тикаем двумя независимыми FSM.
   8:Core/src/it_handlers.c ****  *
   9:Core/src/it_handlers.c ****  * 1) FSM кнопки PC13.
  10:Core/src/it_handlers.c ****  *    - BTN_IDLE: ничего не делаем, ждём, пока EXTI15_10 переведёт
  11:Core/src/it_handlers.c ****  *      в BTN_PRESSED.
  12:Core/src/it_handlers.c ****  *    - BTN_PRESSED: сначала набираем BTN_DEBOUNCE_MS стабильного
  13:Core/src/it_handlers.c ****  *      нажатия. После этого каждый тик увеличиваем btn_hold_m
  14:Core/src/it_handlers.c ****  *      Если за это время кнопку отпустили — SHORT -> сменить
  15:Core/src/it_handlers.c ****  *      Если добрали до BTN_LONG_PRESS_MS — LONG -> переключить пита�
  16:Core/src/it_handlers.c ****  *      перейти в BTN_LONG_FIRED.
  17:Core/src/it_handlers.c ****  *    - BTN_LONG_FIRED: ждём отпускания, чтобы не сработало втор�
  18:Core/src/it_handlers.c ****  *      "короткое" нажатие при отрыве пальца.
  19:Core/src/it_handlers.c ****  *
  20:Core/src/it_handlers.c ****  * 2) PIR-таймер.
  21:Core/src/it_handlers.c ****  *    pir_sens ставится в EXTI3. Здесь из него получаем pir_state:
  22:Core/src/it_handlers.c ****  *    - если pir_sens == DETECTED: WORK, сбрасываем pir_time;
  23:Core/src/it_handlers.c ****  *    - если NO_DETECTED и pir_time >= DETECTING_TIME: CHILL.
  24:Core/src/it_handlers.c ****  */
  25:Core/src/it_handlers.c **** void SysTick_Handler(void)
  26:Core/src/it_handlers.c **** {
  27:Core/src/it_handlers.c ****     bool pin_pressed = (GPIOC->IDR & GPIO_IDR_ID13) != 0; // 1 - нажата
  28:Core/src/it_handlers.c **** 
  29:Core/src/it_handlers.c ****     switch (g_app.btn_state)
  30:Core/src/it_handlers.c ****     {
ARM GAS  C:\Users\Asus\AppData\Local\Temp\ccB8okty.s 			page 2


  31:Core/src/it_handlers.c ****     case BTN_IDLE:
  32:Core/src/it_handlers.c ****         break;
  33:Core/src/it_handlers.c **** 
  34:Core/src/it_handlers.c ****     case BTN_PRESSED:
  35:Core/src/it_handlers.c ****         if (++g_app.btn_debounce_ms < BTN_DEBOUNCE_MS) break; // ждём дебаунс
  36:Core/src/it_handlers.c ****         if (pin_pressed)
  37:Core/src/it_handlers.c ****         {
  38:Core/src/it_handlers.c ****             if (++g_app.btn_hold_ms >= BTN_LONG_PRESS_MS)
  39:Core/src/it_handlers.c ****             {
  40:Core/src/it_handlers.c ****                 // LONG: переключаем питание — режим НЕ трогаем
  41:Core/src/it_handlers.c ****                 g_app.pwr_status = (g_app.pwr_status == PWR_ON) ? PWR_OFF : PWR_ON;
  42:Core/src/it_handlers.c ****                 g_app.btn_state = BTN_LONG_FIRED;
  43:Core/src/it_handlers.c ****             }
  44:Core/src/it_handlers.c ****         }
  45:Core/src/it_handlers.c ****         else
  46:Core/src/it_handlers.c ****         {
  47:Core/src/it_handlers.c ****             // SHORT: отпустили, не дойдя до LONG — меняем режим
  48:Core/src/it_handlers.c ****             g_app.mode_btn = next_mode(g_app.mode_btn);
  49:Core/src/it_handlers.c ****             g_app.btn_state = BTN_IDLE;
  50:Core/src/it_handlers.c ****         }
  51:Core/src/it_handlers.c ****         break;
  52:Core/src/it_handlers.c **** 
  53:Core/src/it_handlers.c ****     case BTN_LONG_FIRED:
  54:Core/src/it_handlers.c ****         // Ждём отпускания, ничего больше не делаем
  55:Core/src/it_handlers.c ****         if (!pin_pressed) g_app.btn_state = BTN_IDLE;
  56:Core/src/it_handlers.c ****         break;
  57:Core/src/it_handlers.c ****     }
  58:Core/src/it_handlers.c **** 
  59:Core/src/it_handlers.c ****     /* PIR-таймер: 3 с без движения -> CHILL. */
  60:Core/src/it_handlers.c ****     if (g_app.pir_sens == NO_DETECTED)
  61:Core/src/it_handlers.c ****     {
  62:Core/src/it_handlers.c ****         if (++g_app.pir_time >= DETECTING_TIME)
  63:Core/src/it_handlers.c ****         {
  64:Core/src/it_handlers.c ****             g_app.pir_state = CHILL;
  65:Core/src/it_handlers.c ****             g_app.pir_time = 0U;
  66:Core/src/it_handlers.c ****         }
  67:Core/src/it_handlers.c ****     }
  68:Core/src/it_handlers.c ****     else
  69:Core/src/it_handlers.c ****     {
  70:Core/src/it_handlers.c ****         /* Движение есть — сразу WORK и обнуляем счётчик.
  71:Core/src/it_handlers.c ****          * Если датчик не отпустит DETECTED, WORK будет держаться
  72:Core/src/it_handlers.c ****          * постоянно (это ожидаемо для PIR в активной зоне). 
  73:Core/src/it_handlers.c ****          */
  74:Core/src/it_handlers.c ****         g_app.pir_state = WORK;
  75:Core/src/it_handlers.c ****         g_app.pir_time = 0U;
  76:Core/src/it_handlers.c ****     }
  77:Core/src/it_handlers.c **** }
  78:Core/src/it_handlers.c **** 
  79:Core/src/it_handlers.c **** /**
  80:Core/src/it_handlers.c ****  * @brief EXTI3 — PIR-датчик (PB3). Сработал по RTSR или FTSR.
  81:Core/src/it_handlers.c ****  * Читаем реальный уровень IDR и превращаем в pir_sens.
  82:Core/src/it_handlers.c ****  * Дальше SysTick_Handler сам решит, WORK или CHILL.
  83:Core/src/it_handlers.c ****  */
  84:Core/src/it_handlers.c **** void EXTI3_IRQHandler(void)
  85:Core/src/it_handlers.c **** {
  86:Core/src/it_handlers.c ****     EXTI->PR = EXTI_PR_PR3; // сброс pending
  87:Core/src/it_handlers.c ****     g_app.pir_sens = (GPIOB->IDR & GPIO_IDR_ID3) ? DETECTED : NO_DETECTED;
ARM GAS  C:\Users\Asus\AppData\Local\Temp\ccB8okty.s 			page 3


  88:Core/src/it_handlers.c **** }
  89:Core/src/it_handlers.c **** 
  90:Core/src/it_handlers.c **** /**
  91:Core/src/it_handlers.c ****  * @brief EXTI4 — кнопка SETUP (PA4).
  92:Core/src/it_handlers.c ****  *
  93:Core/src/it_handlers.c ****  * Пока кнопка нажата (высокий уровень из-за pull-down + замы
  94:Core/src/it_handlers.c ****  * settings_btn = SETUP — process.c будет непрерывно читать потенцио
  95:Core/src/it_handlers.c ****  */
  96:Core/src/it_handlers.c **** void EXTI4_IRQHandler(void)
  97:Core/src/it_handlers.c **** {
  98:Core/src/it_handlers.c ****     EXTI->PR = EXTI_PR_PR4;
  99:Core/src/it_handlers.c ****     g_app.settings_btn = (GPIOA->IDR & GPIO_IDR_ID4) ? SETUP : NO_SETUP;
 100:Core/src/it_handlers.c **** }
 101:Core/src/it_handlers.c **** 
 102:Core/src/it_handlers.c **** /**
 103:Core/src/it_handlers.c ****  * @brief EXTI13 — кнопка PC13 (B1 на Nucleo).
 104:Core/src/it_handlers.c ****  * Здесь только "взводим" FSM: переводим IDLE -> PRESSED и обнуля
 105:Core/src/it_handlers.c ****  * таймеры. Дебаунс и LONG обрабатываются в SysTick_Handler.
 106:Core/src/it_handlers.c ****  * Если FSM не в IDLE (уже считаем или ждём отпускания LONG) — 
 107:Core/src/it_handlers.c ****  */
 108:Core/src/it_handlers.c **** void EXTI15_10_IRQHandler(void)
 109:Core/src/it_handlers.c **** {
 110:Core/src/it_handlers.c ****     if (EXTI->PR & EXTI_PR_PR13)
 111:Core/src/it_handlers.c ****     {
 112:Core/src/it_handlers.c ****         EXTI->PR = EXTI_PR_PR13;    // сброс pending
 113:Core/src/it_handlers.c ****         if (g_app.btn_state == BTN_IDLE)
 114:Core/src/it_handlers.c ****         {
 115:Core/src/it_handlers.c ****             g_app.btn_state = BTN_PRESSED;
 116:Core/src/it_handlers.c ****             g_app.btn_hold_ms = 0;
 117:Core/src/it_handlers.c ****             g_app.btn_debounce_ms = 0;
 118:Core/src/it_handlers.c ****         }
 119:Core/src/it_handlers.c ****     }
 120:Core/src/it_handlers.c **** }
 121:Core/src/it_handlers.c **** 
