  85:Core/src/process.c **** /**
  86:Core/src/process.c ****  * @brief АЦП -> процент.
  87:Core/src/process.c ****  *
  88:Core/src/process.c ****  * 1. Прогоняем mean_filter, чтобы сгладить шум потенциометра
  89:Core/src/process.c ****  * 2. filtered / 4095 * 100 -> процент (0..100).
  90:Core/src/process.c ****  * 3. В ENERGY_SAVING делим на 2 (уставка с потенциометра
  91:Core/src/process.c ****  *    дополнительно режется вдвое — "энергосбережение").
  92:Core/src/process.c ****  */
  93:Core/src/process.c **** uint16_t transform(uint8_t channel, G_Mode mode)
  94:Core/src/process.c **** {
  95:Core/src/process.c ****     mean_filter(channel);
  96:Core/src/process.c ****     float pct = (100.0f * g_app.filtered_ch[channel]) / 4095.0f;
  97:Core/src/process.c ****     if (mode == ENERGY_SAVING) pct /= 2.0f;
  98:Core/src/process.c ****     return (uint16_t)pct;
  99:Core/src/process.c **** }
