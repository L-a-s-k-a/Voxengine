  26:Core/src/main.c **** /*
  27:Core/src/main.c **** CLK	        PA5 (SPI1 SCK)
  28:Core/src/main.c **** R	        PA7 (SPI1 MOSI)
  29:Core/src/main.c **** SCLK(LAT)   PG10 Legasy PB0
  30:Core/src/main.c **** OE	        PG11 Legasy PB1
ARM GAS  /tmp/ccHBxWiY.s 			page 2


  31:Core/src/main.c **** A	        PG12 Legasy PB2
  32:Core/src/main.c **** B	        PG13 Legasy PB10
  33:Core/src/main.c **** */
  34:Core/src/main.c **** void P10_TestPixel(void)
  35:Core/src/main.c **** {
  36:Core/src/main.c ****     /*
  37:Core/src/main.c ****      * 128 bits = 16 bytes.
  38:Core/src/main.c ****      * 1 pixel ON, all other pixels OFF.
  39:Core/src/main.c ****      *
  40:Core/src/main.c ****      * Output LOW  -> LED ON
  41:Core/src/main.c ****      * Output HIGH -> LED OFF
  42:Core/src/main.c ****      */
  43:Core/src/main.c **** 
  44:Core/src/main.c ****     const uint8_t data[16] =
  45:Core/src/main.c ****     {
  46:Core/src/main.c ****         0xFF, 0xFF, 0xFF, 0x7F,
  47:Core/src/main.c ****         0x7F, 0xFF, 0xBF, 0xDF,
  48:Core/src/main.c ****         0xFF, 0xFF, 0xFF, 0xFF,
  49:Core/src/main.c ****         0xFF, 0xBF, 0xFF, 0xFF
  50:Core/src/main.c ****     };
  51:Core/src/main.c **** 
  52:Core/src/main.c ****     /* Disable display during data transfer */
  53:Core/src/main.c **** 
  54:Core/src/main.c ****     GPIOG->BSRR = (1U << (11U + 16U));
  55:Core/src/main.c **** 
  56:Core/src/main.c ****     /* Select scan address 00 */
  57:Core/src/main.c **** 
  58:Core/src/main.c ****     GPIOG->BSRR = (1U << (12U + 16U));
  59:Core/src/main.c ****     GPIOG->BSRR = (1U << (13U + 16U));
  60:Core/src/main.c **** 
  61:Core/src/main.c ****     /* Send 128 bits */
  62:Core/src/main.c **** 
  63:Core/src/main.c ****     for (uint32_t i = 0; i < 16U; i++)
  64:Core/src/main.c ****     {
  65:Core/src/main.c ****         SPI1_TransmitByte(data[i]);
  66:Core/src/main.c ****     }
  67:Core/src/main.c **** 
  68:Core/src/main.c ****     /* Latch data: rising edge */
  69:Core/src/main.c **** 
  70:Core/src/main.c ****     GPIOG->BSRR = (1U << (10U + 16U));
  71:Core/src/main.c ****     GPIOG->BSRR = (1U << 10U);
  72:Core/src/main.c **** 
  73:Core/src/main.c ****     /* Enable display */
  74:Core/src/main.c **** 
  75:Core/src/main.c ****     GPIOG->BSRR = (1U << 11U);
  76:Core/src/main.c **** }
  77:Core/src/main.c **** 
